<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.br.unifor</groupId>
	<artifactId>simulador-linguagens-formais</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>simulador-linguagens-formais</name>
	<description>Simulador de linguagens formais, autômatos finitos, GLC, autômatos com pilha e máquinas de Turing</description>
	<url>https://github.com/lpeixotomagalhaes/simulador-linguagens-formais</url>
	<scm>
		<url>https://github.com/lpeixotomagalhaes/simulador-linguagens-formais</url>
	</scm>
	<properties>
		<!-- Java 25: a versão LTS mais recente (setembro de 2025). -->
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
